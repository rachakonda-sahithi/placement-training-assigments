1. Jump Game VII
class Solution {
    public boolean canReach(String s, int minJump, int maxJump) {
        int n = s.length();
        boolean[] dp = new boolean[n];
        dp[0] = true;

        int reachable = 0;

        for (int i = 1; i < n; i++) {
            if (i >= minJump && dp[i - minJump])
                reachable++;

            if (i > maxJump && dp[i - maxJump - 1])
                reachable--;

            dp[i] = reachable > 0 && s.charAt(i) == '0';
        }

        return dp[n - 1];
    }
}
