public class Solution extends GuessGame {

    public int guessNumber(int n) {

        int start=1;
        int end=n;

        while(start<=end){

            int mid=start+(end-start)/2;

            int res=guess(mid);

            if(res==0)
                return mid;

            if(res<0)
                end=mid-1;
            else
                start=mid+1;
        }

        return -1;
    }
}
