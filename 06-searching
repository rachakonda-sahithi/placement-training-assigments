public class BookAllocation {

    static boolean isPossible(int[] arr, int students, int maxPages) {

        int count = 1;
        int pages = 0;

        for (int num : arr) {

            if (pages + num <= maxPages)
                pages += num;

            else {

                count++;
                pages = num;

                if (count > students)
                    return false;
            }
        }

        return true;
    }

    static int allocateBooks(int[] arr, int students) {

        int low = 0;
        int high = 0;

        for (int num : arr) {
            low = Math.max(low, num);
            high += num;
        }

        int ans = high;

        while (low <= high) {

            int mid = low + (high - low) / 2;

            if (isPossible(arr, students, mid)) {
                ans = mid;
                high = mid - 1;
            }

            else
                low = mid + 1;
        }

        return ans;
    }

    public static void main(String[] args) {

        int[] books = {12,34,67,90};

        System.out.println(allocateBooks(books,2));
    }
}
