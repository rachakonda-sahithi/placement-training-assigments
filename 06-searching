class Solution {

    public int splitArray(int[] nums, int k) {

        int low = 0;
        int high = 0;

        for (int num : nums) {
            low = Math.max(low, num);
            high += num;
        }

        while (low < high) {

            int mid = low + (high - low) / 2;

            int pieces = 1;
            int sum = 0;

            for (int num : nums) {

                if (sum + num > mid) {

                    pieces++;
                    sum = num;

                } else
                    sum += num;
            }

            if (pieces > k)
                low = mid + 1;

            else
                high = mid;
        }

        return low;
    }
}
INPUT:nums = [7,2,5,10,8]
k = 2
OUTPUT:18
