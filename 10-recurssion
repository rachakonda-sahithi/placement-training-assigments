2. Maximum and Minimum Value in an Array (GFG)
class Solution {
    public static int[] getMinMax(int[] arr) {
        int min = arr[0];
        int max = arr[0];

        for (int num : arr) {
            if (num < min)
                min = num;
            if (num > max)
                max = num;
        }

        return new int[]{min, max};
    }
}
