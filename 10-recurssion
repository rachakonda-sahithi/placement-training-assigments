1. Sum Triangle from Array
class Solution {
    public static void sumTriangle(int[] arr) {
        if (arr.length < 1)
            return;

        if (arr.length == 1) {
            System.out.println(arr[0]);
            return;
        }

        int[] temp = new int[arr.length - 1];

        for (int i = 0; i < arr.length - 1; i++) {
            temp[i] = arr[i] + arr[i + 1];
        }

        sumTriangle(temp);

        for (int num : arr) {
            System.out.print(num + " ");
        }
        System.out.println();
    }
}
