1. Parsing A Boolean Expression
import java.util.*;

class Solution {
    public boolean parseBoolExpr(String expression) {
        Stack<Character> stack = new Stack<>();

        for (char ch : expression.toCharArray()) {

            if (ch == ',' || ch == '(')
                continue;

            if (ch != ')') {
                stack.push(ch);
            } else {
                boolean hasTrue = false;
                boolean hasFalse = false;

                while (stack.peek() != '!' &&
                       stack.peek() != '&' &&
                       stack.peek() != '|') {

                    char val = stack.pop();
                    if (val == 't')
                        hasTrue = true;
                    else
                        hasFalse = true;
                }

                char op = stack.pop();

                if (op == '!') {
                    stack.push(hasTrue ? 'f' : 't');
                } else if (op == '&') {
                    stack.push(hasFalse ? 'f' : 't');
                } else {
                    stack.push(hasTrue ? 't' : 'f');
                }
            }
        }

        return stack.pop() == 't';
    }
}

2. Special Binary String
import java.util.*;

class Solution {

    public String makeLargestSpecial(String s) {

        if (s.length() <= 2)
            return s;

        List<String> list = new ArrayList<>();

        int count = 0;
        int start = 0;

        for (int i = 0; i < s.length(); i++) {

            if (s.charAt(i) == '1')
                count++;
            else
                count--;

            if (count == 0) {
                list.add("1" +
                        makeLargestSpecial(s.substring(start + 1, i))
                        + "0");
                start = i + 1;
            }
        }

        Collections.sort(list, Collections.reverseOrder());

        StringBuilder ans = new StringBuilder();

        for (String str : list)
            ans.append(str);

        return ans.toString();
    }
}
